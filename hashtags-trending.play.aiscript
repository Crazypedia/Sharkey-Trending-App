/// @ 0.18.0

// Trending Hashtags Display
// Part 1 of Federated Trends Discovery Suite

// Configuration
let MAX_TAGS = 30
let MAX_SNAPSHOTS = 12
let FEDERATED_MODE = true  // Include federated timeline hashtags

// State
var currentTags = []
var isLoading = true
var snapshots = []
var useFederated = FEDERATED_MODE

// Storage functions
@loadSnapshots() {
  let stored = Mk:load("hashtags_snapshots")
  if Core:type(stored) == "obj" {
    if Core:type(stored.snapshots) == "arr" {
      snapshots = stored.snapshots
    }
  }
}

@saveSnapshot(tags) {
  let now = Date:now()

  // Build tags map
  var tagsMap = {}
  for (let i = 0, tags.len) {
    let t = tags[i]
    tagsMap[t.tag] = t.score
  }

  // Create snapshot
  snapshots.push({
    timestamp: now
    tags: tagsMap
  })

  // Trim old snapshots
  if snapshots.len > MAX_SNAPSHOTS {
    snapshots = snapshots.slice((snapshots.len - MAX_SNAPSHOTS), snapshots.len)
  }

  // Save to storage
  Mk:save("hashtags_snapshots", {snapshots: snapshots})
}

// Fetch trending hashtags
@fetchTrends() {
  var tags = []

  eval {
    let result = Mk:api("hashtags/trend", {limit: 25})

    if Core:type(result) == "arr" {
      // Process each trend
      var maxScore = 0

      for (let i = 0, result.len) {
        let item = result[i]
        if Core:type(item) == "obj" {
          var score = 1

          if Core:type(item.usersCount) == "num" {
            score = item.usersCount
          }

          if score > maxScore {
            maxScore = score
          }

          tags.push({
            tag: item.tag
            score: score
            normalized: 0
          })
        }
      }

      // Normalize scores
      if maxScore > 0 {
        for (let i = 0, tags.len) {
          let t = tags[i]
          t.normalized = t.score / maxScore
        }
      }

      // Sort by score descending (bubble sort)
      if tags.len > 1 {
        for (let i = 0, (tags.len - 1)) {
          for (let j = 0, (tags.len - i - 1)) {
            if tags[j].score < tags[j + 1].score {
              let temp = tags[j]
              tags[j] = tags[j + 1]
              tags[j + 1] = temp
            }
          }
        }
      }
    }
  }

  return tags
}

// Fetch federated hashtags from timeline
@fetchFederatedTags() {
  var tags = {}

  eval {
    // Query global/federated timeline for recent posts
    let result = Mk:api("notes/global-timeline", {
      limit: 100
      withFiles: false
    })

    if Core:type(result) == "arr" {
      // Extract hashtags from posts
      for (let i = 0, result.len) {
        let note = result[i]

        if Core:type(note) == "obj" {
          if Core:type(note.tags) == "arr" {
            for (let j = 0, note.tags.len) {
              let tag = note.tags[j]

              // Count tag occurrences
              if Core:type(tags[tag]) == "num" {
                tags[tag] = tags[tag] + 1
              } else {
                tags[tag] = 1
              }
            }
          }
        }
      }
    }
  }

  return tags
}

// Merge local and federated trends
@mergeTrends(localTags, federatedTagMap) {
  var merged = []
  var tagScores = {}

  // Add local trending tags with higher weight
  for (let i = 0, localTags.len) {
    let t = localTags[i]
    tagScores[t.tag] = t.score * 2  // Local trends weighted 2x
  }

  // Add federated tags
  let fedKeys = Core:obj_keys(federatedTagMap)
  for (let i = 0, fedKeys.len) {
    let tag = fedKeys[i]
    let count = federatedTagMap[tag]

    if Core:type(tagScores[tag]) == "num" {
      tagScores[tag] = tagScores[tag] + count
    } else {
      tagScores[tag] = count
    }
  }

  // Convert to array
  let allKeys = Core:obj_keys(tagScores)
  var maxScore = 0

  for (let i = 0, allKeys.len) {
    let tag = allKeys[i]
    let score = tagScores[tag]

    if score > maxScore {
      maxScore = score
    }

    merged.push({
      tag: tag
      score: score
      normalized: 0
    })
  }

  // Normalize scores
  if maxScore > 0 {
    for (let i = 0, merged.len) {
      let t = merged[i]
      t.normalized = t.score / maxScore
    }
  }

  // Sort by score descending (bubble sort)
  if merged.len > 1 {
    for (let i = 0, (merged.len - 1)) {
      for (let j = 0, (merged.len - i - 1)) {
        if merged[j].score < merged[j + 1].score {
          let temp = merged[j]
          merged[j] = merged[j + 1]
          merged[j + 1] = temp
        }
      }
    }
  }

  return merged
}

// Refresh function
@doRefresh() {
  isLoading = true
  render()

  let localTags = fetchTrends()

  // Merge with federated trends if enabled
  if useFederated {
    let federatedTagMap = fetchFederatedTags()
    currentTags = mergeTrends(localTags, federatedTagMap)
  } else {
    currentTags = localTags
  }

  // Limit to MAX_TAGS
  if currentTags.len > MAX_TAGS {
    currentTags = currentTags.slice(0, MAX_TAGS)
  }

  // Save snapshot if we got tags
  if currentTags.len > 0 {
    saveSnapshot(currentTags)
  }

  isLoading = false
  render()
}

// Toggle federated mode
@toggleFederated() {
  useFederated = !useFederated
  doRefresh()
}

// Main render
@render() {
  var content = []

  // Header
  content.push(Ui:C:mfm({
    text: "# Trending Hashtags"
    size: 1.5
  }))

  if isLoading {
    content.push(Ui:C:text({
      text: "Loading..."
    }))
  } else {
    // Refresh button
    content.push(Ui:C:button({
      text: "🔄 Refresh"
      onClick: doRefresh
    }))

    // Federated mode toggle
    var modeText = "📡 Federated: ON"
    if !useFederated {
      modeText = "📡 Federated: OFF"
    }
    content.push(Ui:C:button({
      text: modeText
      onClick: toggleFederated
    }))

    // Status
    var statusText = `Tags: {currentTags.len} | Snapshots: {snapshots.len}`
    if useFederated {
      statusText = `{statusText} | Mode: Local + Federated`
    } else {
      statusText = `{statusText} | Mode: Local Only`
    }
    content.push(Ui:C:text({
      text: statusText
    }))

    // Word cloud (visual display only)
    if currentTags.len > 0 {
      // Build word cloud - sorted by popularity
      var cloudText = ""

      for (let i = 0, currentTags.len) {
        let tag = currentTags[i]

        // Add separator after top 5 for visual break
        if i == 5 {
          cloudText = `{cloudText}{Str:lf}---{Str:lf}`
        }

        cloudText = `{cloudText}#{tag.tag}   `
      }

      content.push(Ui:C:mfm({
        text: cloudText
      }))

      content.push(Ui:C:text({
        text: "↑ Top 5 most popular above the line"
      }))
    } else {
      content.push(Ui:C:text({
        text: "No trending tags found"
      }))
    }
  }

  Ui:render(content)
}

// Initialize
loadSnapshots()

isLoading = true
render()

let localTags = fetchTrends()

// Merge with federated trends if enabled
if useFederated {
  let federatedTagMap = fetchFederatedTags()
  currentTags = mergeTrends(localTags, federatedTagMap)
} else {
  currentTags = localTags
}

// Limit to MAX_TAGS
if currentTags.len > MAX_TAGS {
  currentTags = currentTags.slice(0, MAX_TAGS)
}

// Save initial snapshot
if currentTags.len > 0 {
  saveSnapshot(currentTags)
}

isLoading = false
render()
