  return external
}

// Merge local and external tags
@mergeTags(localTags, externalTags) {
  var merged = {}

  // Add local tags
  for (let i = 0, localTags.len) {
    let tag = localTags[i]
    merged[tag.tag] = {
      tag: tag.tag
      localScore: tag.score
      externalScore: 0
      totalScore: tag.score
      normalized: 0
    }
  }

  // Add/merge external tags
  for (let i = 0, externalTags.len) {
    let tag = externalTags[i]
    if Core:type(merged[tag.tag]) == "obj" {
      // Tag exists in both - merge scores
      merged[tag.tag].externalScore = tag.score
      merged[tag.tag].totalScore = merged[tag.tag].localScore + tag.score
    } else {
      // New tag from external source
      merged[tag.tag] = {
        tag: tag.tag
        localScore: 0
        externalScore: tag.score
        totalScore: tag.score
        normalized: 0
      }
    }
  }

  // Convert to array and normalize
  var result = []
  let keys = Core:obj_keys(merged)
  var maxScore = 0

  for (let i = 0, keys.len) {
    let key = keys[i]
    let item = merged[key]
    result.push(item)
    if item.totalScore > maxScore {
      maxScore = item.totalScore
    }
  }

  // Normalize scores
  if maxScore > 0 {
    for (let i = 0, result.len) {
      result[i].normalized = result[i].totalScore / maxScore
    }
  }

  // Sort by total score
  if result.len > 1 {
    for (let i = 0, (result.len - 1)) {
      for (let j = 0, (result.len - i - 1)) {
        if result[j].totalScore < result[j + 1].totalScore {
          let temp = result[j]
          result[j] = result[j + 1]
          result[j + 1] = temp
        }
      }
    }
  }

  return result
}

// Fetch posts for a tag
@fetchPostsForTag(tag) {
  var posts = []

  eval {
    let result = Mk:api("notes/search-by-tag", {
      tag: tag
      limit: POST_PREVIEW_LIMIT
    })

    if Core:type(result) == "arr" {
      posts = result
    }
  }

  // Fallback to notes/search if needed
  if posts.len == 0 {
    eval {
      let result = Mk:api("notes/search", {
        query: `#{tag}`
        limit: POST_PREVIEW_LIMIT
      })

      if Core:type(result) == "arr" {
        posts = result
      }
    }
  }

  return posts
}

// Handle tag click
@handleTagClick(tag) {
  // Fetch and show posts
  let posts = fetchPostsForTag(tag)

  if posts.len > 0 {
    var msg = `Recent posts for #{tag}:{Str:lf}{Str:lf}`

    for (let i = 0, posts.len) {
      let post = posts[i]
      if Core:type(post.text) == "str" {
        let preview = post.text.slice(0, 100)
        msg = `{msg}- {preview}{Str:lf}{Str:lf}`
      }
    }

    Mk:dialog("Posts", msg, "info")
  } else {
    Mk:dialog("No Posts", `No recent posts found for #{tag}`, "info")
  }
}

// Calculate MFM size scale for tag
@getTagSizeScale(normalized) {
  // Map normalized score (0-1) to MFM size scale
  if normalized >= 0.8 {
    return "x3"      // Largest (80-100%)
  } elif normalized >= 0.6 {
    return "x2"      // Large (60-80%)
  } elif normalized >= 0.4 {
    return "1.5"     // Medium-large (40-60%)
  } elif normalized >= 0.2 {
    return "1.2"     // Medium (20-40%)
  } else {
    return "1"       // Base size (0-20%)
  }
}

// Render hashtag cloud (inline word cloud)
@renderTags(tags) {
  var buttons = []

  for (let index = 0, tags.len) {
    let tag = tags[index]

    // Top 5 tags are primary (highlighted)
    let isPrimary = index < 5

    let tagCopy = tag.tag // Capture for closure

    // Create button with tag name
    buttons.push(Ui:C:button({
      text: `#{tag.tag}`
      rounded: true
      primary: isPrimary
      onClick: @() {
        handleTagClick(tagCopy)
      }
    }))
  }

  return buttons
}

// Refresh function
@doRefresh() {
  isLoading = true
  render()

  // Fetch local trends
  let localTags = fetchTrends()

  // Fetch external trends (stub - currently returns empty)
  externalTags = fetchExternalTrends()

  // Merge local and external tags
  currentTags = mergeTags(localTags, externalTags)

  // Save snapshot if we got tags
  if currentTags.len > 0 {
    saveSnapshot(currentTags)
  }

  isLoading = false
  render()
}

// Main render
@render() {
  var content = []

  // Header
  content.push(Ui:C:mfm({
    text: "# Trending Hashtags"
    size: 1.5
  }))

  if isLoading {
    content.push(Ui:C:text({
      text: "Loading..."
    }))
  } else {
    // Refresh button
    content.push(Ui:C:button({
      text: "🔄 Refresh"
      onClick: doRefresh
    }))

    // Status
    var statusMsg = `Tags: {currentTags.len} | Snapshots: {snapshots.len}`
    if ENABLE_FEDIBUZZ {
      statusMsg = `{statusMsg} | External: {externalTags.len}`
    }
    content.push(Ui:C:text({
      text: statusMsg
    }))

    // Tag cloud - wrap in container for inline flow
    if currentTags.len > 0 {
      let tagButtons = renderTags(currentTags)
      content.push(Ui:C:container({
        children: tagButtons
        align: "left"
        padding: 8
      }))
    } else {
      content.push(Ui:C:text({
        text: "No trending tags found"
      }))
    }
  }

  Ui:render(content)
}

// Initialize
loadSnapshots()

isLoading = true
render()

// Fetch local and external trends
let localTags = fetchTrends()
externalTags = fetchExternalTrends()

// Merge tags
currentTags = mergeTags(localTags, externalTags)

// Save initial snapshot
if currentTags.len > 0 {
  saveSnapshot(currentTags)
}

isLoading = false
render()
