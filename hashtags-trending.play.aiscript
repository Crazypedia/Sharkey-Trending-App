/// @ 0.18.0

// Trending Hashtags Display
// Part 1 of Federated Trends Discovery Suite

// Configuration
let MAX_TAGS = 30
let MAX_SNAPSHOTS = 12
let POST_PREVIEW_LIMIT = 3

// State
var currentTags = []
var isLoading = true
var snapshots = []

// Storage functions
@loadSnapshots() {
  let stored = Mk:load("hashtags_snapshots")
  if Core:type(stored) == "obj" {
    if Core:type(stored.snapshots) == "arr" {
      snapshots = stored.snapshots
    }
  }
}

@saveSnapshot(tags) {
  let now = Date:now()

  // Build tags map
  var tagsMap = {}
  for (let i = 0, tags.len) {
    let t = tags[i]
    tagsMap[t.tag] = t.score
  }

  // Create snapshot
  snapshots.push({
    timestamp: now
    tags: tagsMap
  })

  // Trim old snapshots
  if snapshots.len > MAX_SNAPSHOTS {
    snapshots = snapshots.slice((snapshots.len - MAX_SNAPSHOTS), snapshots.len)
  }

  // Save to storage
  Mk:save("hashtags_snapshots", {snapshots: snapshots})
}

// Fetch trending hashtags
@fetchTrends() {
  var tags = []

  eval {
    let result = Mk:api("hashtags/trend", {limit: 25})

    if Core:type(result) == "arr" {
      // Process each trend
      var maxScore = 0

      for (let i = 0, result.len) {
        let item = result[i]
        if Core:type(item) == "obj" {
          var score = 1

          if Core:type(item.usersCount) == "num" {
            score = item.usersCount
          }

          if score > maxScore {
            maxScore = score
          }

          tags.push({
            tag: item.tag
            score: score
            normalized: 0
          })
        }
      }

      // Normalize scores
      if maxScore > 0 {
        for (let i = 0, tags.len) {
          let t = tags[i]
          t.normalized = t.score / maxScore
        }
      }

      // Sort by score descending (bubble sort)
      if tags.len > 1 {
        for (let i = 0, (tags.len - 1)) {
          for (let j = 0, (tags.len - i - 1)) {
            if tags[j].score < tags[j + 1].score {
              let temp = tags[j]
              tags[j] = tags[j + 1]
              tags[j + 1] = temp
            }
          }
        }
      }
    }
  }

  return tags
}

// Fetch posts for a tag
@fetchPostsForTag(tag) {
  var posts = []

  eval {
    let result = Mk:api("notes/search-by-tag", {
      tag: tag
      limit: POST_PREVIEW_LIMIT
    })

    if Core:type(result) == "arr" {
      posts = result
    }
  }

  // Fallback to notes/search if needed
  if posts.len == 0 {
    eval {
      let result = Mk:api("notes/search", {
        query: `#{tag}`
        limit: POST_PREVIEW_LIMIT
      })

      if Core:type(result) == "arr" {
        posts = result
      }
    }
  }

  return posts
}

// Handle tag click
@handleTagClick(tag) {
  // Fetch and show posts
  let posts = fetchPostsForTag(tag)

  if posts.len > 0 {
    var msg = `Recent posts for #{tag}:{Str:lf}{Str:lf}`

    for (let i = 0, posts.len) {
      let post = posts[i]
      if Core:type(post.text) == "str" {
        let preview = post.text.slice(0, 100)
        msg = `{msg}- {preview}{Str:lf}{Str:lf}`
      }
    }

    Mk:dialog("Posts", msg, "info")
  } else {
    Mk:dialog("No Posts", `No recent posts found for #{tag}`, "info")
  }
}

// Render hashtag buttons
@renderTags(tags) {
  var buttons = []

  for (let index = 0, tags.len) {
    let tag = tags[index]

    // Top 5 tags are primary (highlighted)
    let isPrimary = index < 5

    let tagCopy = tag.tag // Capture for closure
    buttons.push(Ui:C:button({
      text: `#{tag.tag}`
      rounded: true
      primary: isPrimary
      onClick: @() {
        handleTagClick(tagCopy)
      }
    }))
  }

  return buttons
}

// Refresh function
@doRefresh() {
  isLoading = true
  render()

  currentTags = fetchTrends()

  // Save snapshot if we got tags
  if currentTags.len > 0 {
    saveSnapshot(currentTags)
  }

  isLoading = false
  render()
}

// Main render
@render() {
  var content = []

  // Header
  content.push(Ui:C:mfm({
    text: "# Trending Hashtags"
    size: 1.5
  }))

  if isLoading {
    content.push(Ui:C:text({
      text: "Loading..."
    }))
  } else {
    // Refresh button
    content.push(Ui:C:button({
      text: "🔄 Refresh"
      onClick: doRefresh
    }))

    // Status
    content.push(Ui:C:text({
      text: `Tags: {currentTags.len} | Snapshots: {snapshots.len}`
    }))

    // Tag buttons
    if currentTags.len > 0 {
      let tagButtons = renderTags(currentTags)
      for (let i = 0, tagButtons.len) {
        content.push(tagButtons[i])
      }
    } else {
      content.push(Ui:C:text({
        text: "No trending tags found"
      }))
    }
  }

  Ui:render(content)
}

// Initialize
loadSnapshots()

isLoading = true
render()

currentTags = fetchTrends()

// Save initial snapshot
if currentTags.len > 0 {
  saveSnapshot(currentTags)
}

isLoading = false
render()
