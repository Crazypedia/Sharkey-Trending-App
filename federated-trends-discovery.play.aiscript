/// @ 0.18.0

// Federated Trends Discovery for Misskey/Sharkey
// SPEC-001 Implementation

// Configuration
let MAX_TAGS = 30
let FONT_MIN = 14
let FONT_MAX = 36

// State
var currentTags = []
var isLoading = true

// Fetch trending hashtags
@fetchTrends() {
  var tags = []

  eval {
    let result = Mk:api("hashtags/trend" {limit: 25})

    if Core:type(result) == "arr" {
      // Process each trend
      var maxScore = 0

      each let item result {
        if Core:type(item) == "obj" {
          var score = 1

          if Core:type(item.usersCount) == "num" {
            score = item.usersCount
          }

          if score > maxScore {
            maxScore = score
          }

          tags.push({
            tag: item.tag
            score: score
            normalized: 0
          })
        }
      }

      // Normalize scores
      if maxScore > 0 {
        each let t tags {
          t.normalized = t.score / maxScore
        }
      }
    }
  }

  return tags
}

// Calculate font size
@getFontSize(normalized) {
  let size = FONT_MIN + (normalized * (FONT_MAX - FONT_MIN))
  return Math:floor(size)
}

// Render hashtag buttons
@renderTags(tags) {
  var buttons = []

  each let tag tags {
    let btn = Ui:C:button({
      text: Core:to_str(tag.tag)
      rounded: true
      onClick: @() {
        // Show tag info
        let msg = "Tag: " + tag.tag + Core:lf + "Score: " + Core:to_str(tag.score)
        Mk:dialog("Hashtag Info" msg "info")
      }
    })

    buttons.push(btn)
  }

  return buttons
}

// Main render
@render() {
  var content = []

  // Header
  content.push(Ui:C:text({
    text: "Trending Hashtags"
    size: 1.5
  }))

  if isLoading {
    content.push(Ui:C:text({
      text: "Loading..."
    }))
  } else {
    // Refresh button
    content.push(Ui:C:button({
      text: "Refresh"
      onClick: @() {
        doRefresh()
      }
    }))

    // Status
    let statusMsg = "Tags: " + Core:to_str(currentTags.len)
    content.push(Ui:C:text({
      text: statusMsg
    }))

    // Tag buttons
    if currentTags.len > 0 {
      let tagButtons = renderTags(currentTags)
      each let btn tagButtons {
        content.push(btn)
      }
    } else {
      content.push(Ui:C:text({
        text: "No trending tags found"
      }))
    }
  }

  Ui:render(content)
}

// Refresh function
@doRefresh() {
  isLoading = true
  render()

  currentTags = fetchTrends()

  isLoading = false
  render()
}

// Initialize
isLoading = true
render()

currentTags = fetchTrends()

isLoading = false
render()
