/// @ 0.18.0

// Federated Trends Discovery for Misskey/Sharkey
// SPEC-001 Implementation

// Configuration
let MAX_TAGS = 30
let FONT_MIN = 14
let FONT_MAX = 36
let MAX_SNAPSHOTS = 12
let MAX_MEDIA = 25

// State
var currentTags = []
var isLoading = true
var snapshots = []
var mediaPosts = []

// Storage functions
@loadSnapshots() {
  let stored = Mk:load("trends_snapshots")
  if Core:type(stored) == "obj" {
    if Core:type(stored.snapshots) == "arr" {
      snapshots = stored.snapshots
    }
  }
}

@saveSnapshot(tags) {
  let now = Date:now()

  // Build tags map
  var tagsMap = {}
  each let t tags {
    tagsMap[t.tag] = t.score
  }

  // Create snapshot
  snapshots.push({
    timestamp: now
    tags: tagsMap
  })

  // Trim old snapshots
  if snapshots.len > MAX_SNAPSHOTS {
    snapshots = snapshots.slice((snapshots.len - MAX_SNAPSHOTS) snapshots.len)
  }

  // Save to storage
  Mk:save("trends_snapshots" {snapshots: snapshots})
}

// Fetch trending hashtags
@fetchTrends() {
  var tags = []

  eval {
    let result = Mk:api("hashtags/trend" {limit: 25})

    if Core:type(result) == "arr" {
      // Process each trend
      var maxScore = 0

      each let item result {
        if Core:type(item) == "obj" {
          var score = 1

          if Core:type(item.usersCount) == "num" {
            score = item.usersCount
          }

          if score > maxScore {
            maxScore = score
          }

          tags.push({
            tag: item.tag
            score: score
            normalized: 0
          })
        }
      }

      // Normalize scores
      if maxScore > 0 {
        each let t tags {
          t.normalized = t.score / maxScore
        }
      }

      // Sort by score descending (bubble sort)
      if tags.len > 1 {
        for let i 0 (tags.len - 1) {
          for let j 0 (tags.len - i - 1) {
            if tags[j].score < tags[j + 1].score {
              let temp = tags[j]
              tags[j] = tags[j + 1]
              tags[j + 1] = temp
            }
          }
        }
      }
    }
  }

  return tags
}

// Calculate font size
@getFontSize(normalized) {
  let size = FONT_MIN + (normalized * (FONT_MAX - FONT_MIN))
  return Math:floor(size)
}

// Fetch posts for a tag
@fetchPostsForTag(tag) {
  var posts = []

  eval {
    let result = Mk:api("notes/search-by-tag" {
      tag: tag
      limit: 3
    })

    if Core:type(result) == "arr" {
      posts = result
    }
  }

  // Fallback to notes/search if needed
  if posts.len == 0 {
    eval {
      let result = Mk:api("notes/search" {
        query: `#{tag}`
        limit: 3
      })

      if Core:type(result) == "arr" {
        posts = result
      }
    }
  }

  return posts
}

// Collect media posts from trending tags
@collectMedia() {
  var media = []

  each let tag currentTags {
    if media.len >= MAX_MEDIA {
      break
    }

    // Get posts for this tag
    let posts = fetchPostsForTag(tag.tag)

    each let post posts {
      if media.len >= MAX_MEDIA {
        break
      }

      // Check if post has media files
      if Core:type(post.files) == "arr" {
        if post.files.len > 0 {
          var hasImage = false
          var hasVideo = false

          each let file post.files {
            if Core:type(file.type) == "str" {
              if file.type.incl("image/") {
                hasImage = true
              }
              if file.type.incl("video/") {
                hasVideo = true
              }
            }
          }

          if hasImage || hasVideo {
            media.push({
              post: post
              hasImage: hasImage
              hasVideo: hasVideo
            })
          }
        }
      }
    }
  }

  return media
}

// Render hashtag buttons
@renderTags(tags) {
  var buttons = []
  var index = 0

  each let tag tags {
    // Top 5 tags are primary (highlighted)
    let isPrimary = index < 5

    let btn = Ui:C:button({
      text: `#{tag.tag}`
      rounded: true
      primary: isPrimary
      onClick: @() {
        // Fetch and show posts
        let posts = fetchPostsForTag(tag.tag)

        if posts.len > 0 {
          var msg = `Recent posts for #{tag.tag}:{Core:lf}{Core:lf}`

          each let post posts {
            if Core:type(post.text) == "str" {
              let preview = post.text.slice(0 100)
              msg = `{msg}- {preview}{Core:lf}{Core:lf}`
            }
          }

          Mk:dialog("Posts" msg "info")
        } else {
          Mk:dialog("No Posts" `No recent posts found for #{tag.tag}` "info")
        }
      }
    })

    buttons.push(btn)
    index = index + 1
  }

  return buttons
}

// Render media wall
@renderMedia(media) {
  var buttons = []

  if media.len == 0 {
    buttons.push(Ui:C:text({
      text: "No trending media available"
    }))
  } else {
    each let item media {
      var icon = "🖼️"
      if item.hasVideo {
        icon = "🎥"
      }

      var btnText = icon
      if Core:type(item.post.user) == "obj" {
        btnText = `{icon} @{item.post.user.username}`
      }

      let btn = Ui:C:button({
        text: btnText
        rounded: true
        onClick: @() {
          var msg = ""

          if Core:type(item.post.user) == "obj" {
            msg = `Posted by @{item.post.user.username}{Core:lf}{Core:lf}`
          }

          if Core:type(item.post.text) == "str" {
            let preview = item.post.text.slice(0 200)
            msg = `{msg}{preview}{Core:lf}{Core:lf}`
          }

          if Core:type(item.post.files) == "arr" {
            msg = `{msg}Media files: {item.post.files.len}`
          }

          Mk:dialog("Post Preview" msg "info")
        }
      })

      buttons.push(btn)
    }
  }

  return buttons
}

// Main render
@render() {
  var content = []

  // Header
  content.push(Ui:C:mfm({
    text: "# Trending Hashtags"
    size: 1.5
  }))

  if isLoading {
    content.push(Ui:C:text({
      text: "Loading..."
    }))
  } else {
    // Refresh button
    content.push(Ui:C:button({
      text: "Refresh"
      onClick: @() {
        doRefresh()
      }
    }))

    // Status
    content.push(Ui:C:text({
      text: `Tags: {currentTags.len} | Snapshots: {snapshots.len} | Media: {mediaPosts.len}`
    }))

    // Tag buttons
    if currentTags.len > 0 {
      let tagButtons = renderTags(currentTags)
      each let btn tagButtons {
        content.push(btn)
      }
    } else {
      content.push(Ui:C:text({
        text: "No trending tags found"
      }))
    }

    // Spacer
    content.push(Ui:C:text({text: " "}))

    // Media wall header
    content.push(Ui:C:mfm({
      text: "# Trending Media"
      size: 1.5
    }))

    // Media wall
    let mediaButtons = renderMedia(mediaPosts)
    each let btn mediaButtons {
      content.push(btn)
    }
  }

  Ui:render(content)
}

// Refresh function
@doRefresh() {
  isLoading = true
  render()

  currentTags = fetchTrends()

  // Save snapshot if we got tags
  if currentTags.len > 0 {
    saveSnapshot(currentTags)
  }

  // Collect media from trending tags
  mediaPosts = collectMedia()

  isLoading = false
  render()
}

// Initialize
loadSnapshots()

isLoading = true
render()

currentTags = fetchTrends()

// Save initial snapshot
if currentTags.len > 0 {
  saveSnapshot(currentTags)
}

// Collect initial media
mediaPosts = collectMedia()

isLoading = false
render()
